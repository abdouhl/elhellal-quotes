---
import Layout from "../../layouts/Layout.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import { getQuoteTags } from "../../utils/quotes";

const tags = getQuoteTags();

const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: "الاقتباسات", url: "https://quotes.elhellal.com/" },
  { name: "المواضيع" },
];
---

<Layout
  site="الهلال - اقتباسات حسب الموضوع"
  title="الهلال"
  tagline="أجمل الاقتباسات العربية من أشهر الكتّاب والكتب"
  pageTitle="تصفح الاقتباسات حسب الموضوع | الهلال"
  pageDescription="تصفح جميع المواضيع التي صُنّفت تحتها الاقتباسات الأدبية والفكرية على الهلال."
  canonicalUrl="https://quotes.elhellal.com/tags/"
>
  <BreadcrumbSchema items={breadcrumbs} />

  <main id="main-content" class="page">
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="https://elhellal.com/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href="/">الاقتباسات</a>
      <span aria-hidden="true">›</span>
      <span>المواضيع</span>
    </nav>

    <header class="index-head">
      <p class="eyebrow">تصفّح حسب الموضوع</p>
      <h1 class="page-title">المواضيع</h1>
      <p class="page-lede">{tags.length} موضوعاً مصنّفة على الهلال</p>
    </header>

    <ul role="list" class="chip-list tag-cloud">
      {tags.map((t, i) => (
        <li>
          <a href={`/tag/${encodeURIComponent(t.slug)}/`} class={`chip ${i < 12 ? "chip--big" : ""}`}>
            {t.label}
            <span class="chip-count">{t.quotes.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <style>
    .index-head { margin-bottom: clamp(32px, 5vw, 48px); }
    .tag-cloud { gap: 10px; }
    .chip--big {
      padding: 10px 20px;
      font-family: var(--font-quote);
      font-size: 1.2rem;
      font-weight: 700;
    }
  </style>
</Layout>
