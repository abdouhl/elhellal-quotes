---
import Layout from "../../layouts/Layout.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import { getQuoteTags } from "../../utils/quotes";

const tags = getQuoteTags();

const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: "الاقتباسات", url: "https://quotes.elhellal.com/" },
  { name: "المواضيع" },
];
---

<Layout
  site="الهلال - اقتباسات حسب الموضوع"
  title="الهلال"
  tagline="أجمل الاقتباسات العربية من أشهر الكتّاب والكتب"
  pageTitle="تصفح الاقتباسات حسب الموضوع | الهلال"
  pageDescription="تصفح جميع المواضيع التي صُنّفت تحتها الاقتباسات الأدبية والفكرية على الهلال."
  canonicalUrl="https://quotes.elhellal.com/tags/"
>
  <BreadcrumbSchema items={breadcrumbs} />

  <main id="main-content" class="tags-index-page">
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="https://elhellal.com/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href="/">الاقتباسات</a>
      <span aria-hidden="true">›</span>
      <span>المواضيع</span>
    </nav>

    <header class="tags-header">
      <h1>تصفح حسب الموضوع</h1>
      <p>{tags.length} موضوعاً مصنّفة على الهلال</p>
    </header>

    <ul role="list" class="tag-cloud">
      {tags.map((t) => (
        <li>
          <a href={`/tag/${encodeURIComponent(t.slug)}/`} class="tag-pill">
            {t.label}
            <span class="tag-pill-count">{t.quotes.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <style>
    .tags-index-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: var(--spacing-06) var(--spacing-05) var(--spacing-10);
    }
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: var(--desktop-caption);
      font-family: var(--monospace);
      color: var(--content-secondary);
      margin-bottom: var(--spacing-06);
    }
    .breadcrumb a { color: var(--content-secondary); text-decoration: none; }
    .breadcrumb a:hover { color: var(--content-primary); }

    .tags-header {
      margin-bottom: var(--spacing-07);
    }
    .tags-header h1 {
      margin: 0 0 var(--spacing-02) 0;
      font-size: clamp(1.5rem, 3vw, 2rem);
    }
    .tags-header p {
      margin: 0;
      font-family: var(--monospace);
      font-size: var(--desktop-body-sm);
      color: var(--content-secondary);
    }

    .tag-cloud {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .tag-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: rgba(255, 140, 0, 0.08);
      border: 0.5px solid rgba(255, 140, 0, 0.25);
      color: DarkOrange;
      border-radius: 20px;
      font-size: var(--desktop-body-sm);
      text-decoration: none;
      transition: background 0.15s ease, transform 0.15s ease;
    }
    .tag-pill:hover {
      background: rgba(255, 140, 0, 0.18);
      transform: translateY(-1px);
    }
    .tag-pill-count {
      font-family: var(--monospace);
      font-size: 11px;
      opacity: 0.7;
    }
  </style>
</Layout>
