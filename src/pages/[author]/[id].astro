---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import AdUnit from "../../components/AdUnit.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import QuoteSchema from "../../components/schema/QuoteSchema.astro";
import PersonSchema from "../../components/schema/PersonSchema.astro";
import { slugifyTag } from "../../utils/tag-slug";
import { loadQuoteShard } from "../../utils/quote-shard";
import type { FlatQuote } from "../../types";

const { author: authorParam, id } = Astro.params;

// Precomputed at build time by scripts/generate-quote-indices.ts — this is a
// single small static-asset fetch (one of a fixed number of shards, not one file
// per quote) instead of loading all ~15k quotes and scanning for a match on
// every request, which was blowing the Workers CPU budget.
type QuotePayload = FlatQuote & { authorQuoteCount: number; otherQuotes: FlatQuote[] };
const shard = await loadQuoteShard<QuotePayload>("by-id", id as string, Astro);
const quote: QuotePayload | undefined = shard?.[id as string];

if (!quote) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

// Canonicalize to the quote's real author slug so the same quote isn't
// servable under an unrelated author path.
if (quote.authorSlug !== authorParam) {
  return Astro.redirect(
    `/${encodeURIComponent(quote.authorSlug)}/${encodeURIComponent(quote.id)}/`,
    301
  );
}

// Quotes are immutable, so cache the rendered page for a month (browser + Cloudflare edge).
// Set only after the 404/redirect branches above so those aren't cached for a month.
Astro.response.headers.set("Cache-Control", "public, max-age=2592000, s-maxage=2592000");

const authorUrl = `https://quotes.elhellal.com/${encodeURIComponent(quote.authorSlug)}/`;
const canonicalUrl = `${authorUrl}${encodeURIComponent(quote.id)}/`;

const otherQuotes = quote.otherQuotes;

const shareText = quote.book
  ? `"${quote.text}" — ${quote.author}، ${quote.book}`
  : `"${quote.text}" — ${quote.author}`;
const encText = encodeURIComponent(shareText);
const encUrl = encodeURIComponent(canonicalUrl);
const shareLinks = [
  { key: "whatsapp", label: "واتساب", href: `https://api.whatsapp.com/send?text=${encodeURIComponent(`${shareText} ${canonicalUrl}`)}` },
  { key: "x", label: "X", href: `https://x.com/intent/post?text=${encText}&url=${encUrl}` },
  { key: "facebook", label: "فيسبوك", href: `https://www.facebook.com/sharer/sharer.php?u=${encUrl}` },
  { key: "telegram", label: "تيليجرام", href: `https://t.me/share/url?url=${encUrl}&text=${encText}` },
];

const previewText = quote.text.length > 60 ? `${quote.text.slice(0, 60)}…` : quote.text;
const heroSizeTier = quote.text.length <= 50 ? "xl" : quote.text.length <= 100 ? "lg" : quote.text.length <= 170 ? "md" : "sm";
const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: "الاقتباسات", url: "https://quotes.elhellal.com/" },
  { name: quote.author, url: authorUrl },
  { name: previewText },
];

const pageDescription = quote.book
  ? `اقتباس لـ${quote.author} من كتاب "${quote.book}": ${previewText}`
  : `اقتباس لـ${quote.author}: ${previewText}`;
---

<Layout
  site={`الهلال - اقتباس لـ${quote.author}`}
  title="الهلال"
  tagline="أجمل الاقتباسات العربية من أشهر الكتّاب والكتب"
  pageTitle={`"${previewText}" — ${quote.author} | الهلال`}
  pageDescription={pageDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={`اقتباس لـ${quote.author}`}
  ogDescription={quote.text}
  ogUrl={canonicalUrl}
  ogType="article"
>
  <PersonSchema name={quote.author} url={authorUrl} image={quote.authorImage} />
  <QuoteSchema quotes={[quote]} url={canonicalUrl} />
  <BreadcrumbSchema items={breadcrumbs} />

  <main id="main-content" class="page">
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="https://elhellal.com/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href="/">الاقتباسات</a>
      <span aria-hidden="true">›</span>
      <a href={`/${encodeURIComponent(quote.authorSlug)}/`}>{quote.author}</a>
    </nav>

    <article class="poster theme-night">
      <span class="poster-mark" aria-hidden="true">&ldquo;</span>
      <blockquote class={`poster-text poster-text-${heroSizeTier}`}>{quote.text}</blockquote>

      <div class="poster-by">
        {quote.authorImage ? (
          <img src={quote.authorImage} alt={quote.author} class="avatar" loading="eager" width="56" height="56" style="width:56px;height:56px" />
        ) : (
          <span class="avatar avatar--initial" aria-hidden="true" style="width:56px;height:56px;font-size:24px">{quote.author.trim().charAt(0)}</span>
        )}
        <span class="poster-by-text">
          <a href={`/${encodeURIComponent(quote.authorSlug)}/`} class="poster-author">{quote.author}</a>
          {quote.book && (
            quote.bookSlug
              ? <a href={`/book/${encodeURIComponent(quote.bookSlug)}/`} class="poster-book">«{quote.book}»</a>
              : <span class="poster-book">«{quote.book}»</span>
          )}
        </span>
      </div>

      {quote.tags && quote.tags.length > 0 && (
        <div class="poster-tags">
          {quote.tags.filter((tag): tag is string => typeof tag === "string").map((tag) => (
            <a href={`/tag/${encodeURIComponent(slugifyTag(tag))}/`} class="chip">#{tag}</a>
          ))}
        </div>
      )}

      <div class="quote-share">
        <span class="share-label">شارك الاقتباس</span>
          <div class="share-buttons">
            {shareLinks.map((l) => (
              <a href={l.href} target="_blank" rel="noopener noreferrer" class={`share-btn share-btn--${l.key}`} title={`مشاركة عبر ${l.label}`} aria-label={`مشاركة عبر ${l.label}`}>
                {l.key === "whatsapp" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 448 512"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" /></svg>
                )}
                {l.key === "x" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
                )}
                {l.key === "facebook" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 320 512"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z" /></svg>
                )}
                {l.key === "telegram" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="currentColor" viewBox="0 0 24 24"><path d="M9.78 15.35 9.4 20.6c.54 0 .77-.23 1.05-.51l2.52-2.41 5.22 3.82c.96.53 1.63.25 1.89-.88l3.42-16.03h0c.3-1.4-.51-1.95-1.45-1.6L1.97 10.7c-1.37.53-1.35 1.29-.23 1.64l5.15 1.6L18.85 6.4c.56-.37 1.07-.17.65.2z" /></svg>
                )}
              </a>
            ))}
            <button type="button" class="share-btn" id="copyQuoteBtn" title="نسخ الاقتباس" aria-label="نسخ نص الاقتباس" data-text={shareText}>
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="currentColor" viewBox="0 0 256 256"><path d="M216,32H88a8,8,0,0,0-8,8V80H40a8,8,0,0,0-8,8V216a8,8,0,0,0,8,8H168a8,8,0,0,0,8-8V176h40a8,8,0,0,0,8-8V40A8,8,0,0,0,216,32ZM160,208H48V96H160Zm48-48H176V88a8,8,0,0,0-8-8H96V48H208Z" /></svg>
            </button>
            <button type="button" class="share-btn" id="copyLinkBtn" title="نسخ الرابط" aria-label="نسخ رابط الاقتباس" data-url={canonicalUrl}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M240,88.23a54.43,54.43,0,0,1-16,37L189.25,160a54.27,54.27,0,0,1-38.63,16h-.05A54.63,54.63,0,0,1,96,119.84a8,8,0,0,1,16,.45A38.62,38.62,0,0,0,150.58,160h0a38.39,38.39,0,0,0,27.31-11.31l34.75-34.75a38.63,38.63,0,0,0-54.63-54.63l-11,11A8,8,0,0,1,135.7,59l11-11A54.65,54.65,0,0,1,224,48,54.86,54.86,0,0,1,240,88.23ZM109,185.66l-11,11A38.41,38.41,0,0,1,70.6,208h0a38.63,38.63,0,0,1-27.29-65.94L78,107.31A38.63,38.63,0,0,1,144,135.71a8,8,0,0,0,16,.45A54.86,54.86,0,0,0,144,96a54.65,54.65,0,0,0-77.27,0L32,130.75A54.62,54.62,0,0,0,70.56,224h0a54.28,54.28,0,0,0,38.64-16l11-11A8,8,0,0,0,109,185.66Z" /></svg>
            </button>
            <button type="button" class="share-btn share-btn--native" id="nativeShareBtn" title="مشاركة" aria-label="مشاركة" hidden data-text={shareText} data-url={canonicalUrl}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7" /><polyline points="16 6 12 2 8 6" /><line x1="12" y1="2" x2="12" y2="15" /></svg>
            </button>
          </div>
        </div>
    </article>

    <div class="context-cards">
      <a href={`/${encodeURIComponent(quote.authorSlug)}/`} class="context-card">
        {quote.authorImage ? (
          <img src={quote.authorImage} alt="" class="avatar" loading="lazy" width="52" height="52" style="width:52px;height:52px" />
        ) : (
          <span class="avatar avatar--initial" aria-hidden="true" style="width:52px;height:52px;font-size:22px">{quote.author.trim().charAt(0)}</span>
        )}
        <span class="context-text">
          <span class="context-label">القائل</span>
          <span class="context-title">{quote.author}</span>
          <span class="context-meta">كل اقتباساته ({quote.authorQuoteCount}) ←</span>
        </span>
      </a>
      {quote.book && quote.bookSlug && (
        <a href={`/book/${encodeURIComponent(quote.bookSlug)}/`} class="context-card">
          {quote.bookCover ? (
            <img src={quote.bookCover} alt="" class="cover" loading="lazy" style="width:48px" />
          ) : (
            <span class="cover cover--initial" aria-hidden="true" style="width:48px;font-size:1.2rem">{quote.book.trim().charAt(0)}</span>
          )}
          <span class="context-text">
            <span class="context-label">من كتاب</span>
            <span class="context-title">{quote.book}</span>
            <span class="context-meta">كل اقتباسات الكتاب ←</span>
          </span>
        </a>
      )}
    </div>

    <!-- Ads sit below the whole quote card (share row included) so they're never next to a tappable share button. -->
    <div class="adsense-slot" aria-label="Advertisement">
      <AdUnit slot="2951250905" minHeight={250} />
    </div>

    {otherQuotes.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>المزيد من اقتباسات {quote.author}</h2>
          <a href={`/${encodeURIComponent(quote.authorSlug)}/`} class="see-all">الكل ←</a>
        </div>
        <ul role="list" class="related-grid">
          {otherQuotes.map((q) => (
            <li>
              <a href={`/${encodeURIComponent(q.authorSlug)}/${encodeURIComponent(q.id)}/`} class="related-card">
                <span class="related-text">{q.text}</span>
                {q.book && <span class="related-book">«{q.book}»</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <AdUnit slot="8525183818" format="fluid" layout="in-article" className="quote-page-ad" />
  </main>

  <script>
    function flash(btn: HTMLElement) {
      const original = btn.innerHTML;
      btn.classList.add("share-btn--done");
      btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>';
      setTimeout(() => {
        btn.innerHTML = original;
        btn.classList.remove("share-btn--done");
      }, 1800);
    }

    function copyFrom(id: string, attr: "text" | "url") {
      const btn = document.getElementById(id);
      btn?.addEventListener("click", () => {
        const value = btn.dataset[attr];
        if (value) navigator.clipboard?.writeText(value).then(() => flash(btn));
      });
    }
    copyFrom("copyQuoteBtn", "text");
    copyFrom("copyLinkBtn", "url");

    const nativeBtn = document.getElementById("nativeShareBtn");
    if (nativeBtn && typeof navigator.share === "function") {
      nativeBtn.hidden = false;
      nativeBtn.addEventListener("click", () => {
        navigator
          .share({ text: nativeBtn.dataset.text, url: nativeBtn.dataset.url })
          .catch(() => {});
      });
    }
  </script>

  <style>
    /* ── Poster ── */
    .poster {
      position: relative;
      max-width: 860px;
      margin: 0 auto;
      padding: clamp(40px, 7vw, 80px) clamp(22px, 7vw, 80px) clamp(28px, 4vw, 40px);
      text-align: center;
      border: 1px solid rgba(255, 140, 0, 0.35);
      border-radius: 28px;
      box-shadow: var(--shadow-md);
    }
    .poster-mark {
      display: block;
      height: 56px;
      font-family: var(--font-quote);
      font-size: 110px;
      line-height: 1;
      color: var(--accent);
    }
    .poster-text {
      margin: 12px 0 0;
      font-family: var(--font-quote);
      font-weight: 700;
      color: var(--ink);
      text-wrap: balance;
    }
    .poster-text-xl { font-size: clamp(2rem, 5.5vw, 3.4rem); line-height: 1.55; }
    .poster-text-lg { font-size: clamp(1.7rem, 4.2vw, 2.6rem); line-height: 1.65; }
    .poster-text-md { font-size: clamp(1.45rem, 3.2vw, 2rem); line-height: 1.8; }
    .poster-text-sm { font-size: clamp(1.2rem, 2.4vw, 1.5rem); line-height: 1.95; font-weight: 400; text-wrap: pretty; }

    .poster-by {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      margin-top: 36px;
      text-align: start;
    }
    .poster-by::before {
      content: "";
      width: 32px;
      height: 2px;
      background: var(--accent);
      border-radius: 2px;
    }
    .poster-by-text { display: flex; flex-direction: column; line-height: 1.45; }
    .poster-author {
      font-family: var(--font-ui-bold);
      font-size: 18px;
      color: var(--ink);
      text-decoration: none;
    }
    .poster-author:hover { color: var(--accent); }
    .poster-book { font-size: 14px; color: var(--ink-3); text-decoration: none; }
    a.poster-book:hover { color: var(--accent); }

    .poster-tags {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin-top: 28px;
    }
    .poster-tags .chip { padding: 4px 12px; font-size: 13px; color: var(--ink-2); }

    /* ── Share ── */
    .quote-share {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      margin-top: 36px;
      padding-top: 28px;
      border-top: 1px solid var(--line);
    }
    .share-label { font-size: 13px; color: var(--ink-3); }
    .share-buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
    .share-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
      background: var(--surface);
      border: 1px solid var(--line-strong);
      border-radius: 50%;
      color: var(--ink-2);
      text-decoration: none;
      cursor: pointer;
      transition: background 0.15s, color 0.15s, border-color 0.15s, transform 0.15s;
    }
    .share-btn[hidden] { display: none; }
    .share-btn:hover { color: var(--accent); border-color: var(--accent); transform: translateY(-2px); }
    .share-btn--whatsapp:hover { color: #fff; background: #1faa54; border-color: #1faa54; }
    .share-btn--x:hover { color: var(--paper); background: var(--ink); border-color: var(--ink); }
    .share-btn--facebook:hover { color: #fff; background: #1877f2; border-color: #1877f2; }
    .share-btn--telegram:hover { color: #fff; background: #2aabee; border-color: #2aabee; }
    .share-btn--done { color: #2f9e5b; border-color: #2f9e5b; }

    /* ── Author / book context ── */
    .context-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
      max-width: 860px;
      margin: 20px auto 0;
    }
    .context-card {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 18px 20px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      color: var(--ink);
      text-decoration: none;
      transition: border-color 0.15s, transform 0.15s;
    }
    .context-card:hover { border-color: var(--accent); color: var(--ink); transform: translateY(-2px); }
    .context-text { display: flex; flex-direction: column; min-width: 0; line-height: 1.45; }
    .context-label { font-size: 12px; color: var(--ink-3); }
    .context-title {
      font-family: var(--font-ui-bold);
      font-size: 16px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .context-meta { font-size: 13px; color: var(--accent); }

    .adsense-slot {
      max-width: 860px;
      margin: 40px auto 0;
    }

    /* ── More quotes: compact cards, no hydration ── */
    .related-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 16px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .related-card {
      display: flex;
      flex-direction: column;
      gap: 12px;
      height: 100%;
      padding: 22px 24px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      color: var(--ink);
      text-decoration: none;
      transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
    }
    .related-card:hover {
      color: var(--ink);
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
      border-color: var(--line-strong);
    }
    .related-text {
      font-family: var(--font-quote);
      font-size: 1.15rem;
      line-height: 1.85;
      display: -webkit-box;
      -webkit-line-clamp: 5;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .related-book { margin-top: auto; font-size: 12px; color: var(--ink-3); }
  </style>
</Layout>
