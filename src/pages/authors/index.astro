---
import Layout from "../../layouts/Layout.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import { getQuoteAuthors } from "../../utils/quotes";

const authors = getQuoteAuthors();

const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: "الاقتباسات", url: "https://quotes.elhellal.com/" },
  { name: "الكتّاب" },
];
---

<Layout
  site="الهلال - اقتباسات حسب الكاتب"
  title="الهلال"
  tagline="أجمل الاقتباسات العربية من أشهر الكتّاب والكتب"
  pageTitle="تصفح الاقتباسات حسب الكاتب | الهلال"
  pageDescription="تصفح جميع الكتّاب الذين استُخرجت منهم الاقتباسات الأدبية والفكرية على الهلال."
  canonicalUrl="https://quotes.elhellal.com/authors/"
>
  <BreadcrumbSchema items={breadcrumbs} />

  <main id="main-content" class="authors-index-page">
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="https://elhellal.com/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href="/">الاقتباسات</a>
      <span aria-hidden="true">›</span>
      <span>الكتّاب</span>
    </nav>

    <header class="authors-header">
      <h1>تصفح حسب الكاتب</h1>
      <p>{authors.length} كاتباً لهم اقتباسات على الهلال</p>
    </header>

    <ul role="list" class="author-grid">
      {authors.map((a) => (
        <li>
          <a href={`/${encodeURIComponent(a.slug)}/`} class="author-card">
            {a.authorImage ? (
              <img src={a.authorImage} alt={a.author} class="author-card-avatar" loading="lazy" />
            ) : (
              <span class="author-card-avatar author-card-avatar-fallback" aria-hidden="true">{a.author.trim().charAt(0)}</span>
            )}
            <span class="author-card-name">{a.author}</span>
            <span class="author-card-count">{a.quotes.length} اقتباساً</span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <style>
    .authors-index-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: var(--spacing-06) var(--spacing-05) var(--spacing-10);
    }
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: var(--desktop-caption);
      font-family: var(--monospace);
      color: var(--content-secondary);
      margin-bottom: var(--spacing-06);
    }
    .breadcrumb a { color: var(--content-secondary); text-decoration: none; }
    .breadcrumb a:hover { color: var(--content-primary); }

    .authors-header {
      margin-bottom: var(--spacing-07);
    }
    .authors-header h1 {
      margin: 0 0 var(--spacing-02) 0;
      font-size: clamp(1.5rem, 3vw, 2rem);
    }
    .authors-header p {
      margin: 0;
      font-family: var(--monospace);
      font-size: var(--desktop-body-sm);
      color: var(--content-secondary);
    }

    .author-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: var(--spacing-05);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .author-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      padding: var(--spacing-05) var(--spacing-03);
      background: var(--background-secondary);
      border: 0.5px solid var(--border-muted);
      border-radius: 8px;
      text-decoration: none;
      text-align: center;
      transition: transform 0.15s ease, border-color 0.15s ease;
    }
    .author-card:hover {
      transform: translateY(-2px);
      border-color: DarkOrange;
    }
    .author-card-avatar {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      object-fit: cover;
      background: var(--background-selected);
      box-shadow: 0 0 0 2px rgba(255, 140, 0, 0.3);
    }
    .author-card-avatar-fallback {
      display: flex;
      align-items: center;
      justify-content: center;
      color: DarkOrange;
      background: rgba(255, 140, 0, 0.1);
      font-weight: 700;
      font-size: 1.75rem;
    }
    .author-card-name {
      font-size: var(--desktop-body-sm);
      font-weight: 600;
      color: var(--content-primary);
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .author-card-count {
      font-family: var(--monospace);
      font-size: 11px;
      color: DarkOrange;
    }
  </style>
</Layout>
