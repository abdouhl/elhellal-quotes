---
import Layout from "../../layouts/Layout.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import { getQuoteAuthors } from "../../utils/quotes";

const authors = getQuoteAuthors();

const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: "الاقتباسات", url: "https://quotes.elhellal.com/" },
  { name: "الكتّاب" },
];
---

<Layout
  site="الهلال - اقتباسات حسب الكاتب"
  title="الهلال"
  tagline="أجمل الاقتباسات العربية من أشهر الكتّاب والكتب"
  pageTitle="تصفح الاقتباسات حسب الكاتب | الهلال"
  pageDescription="تصفح جميع الكتّاب الذين استُخرجت منهم الاقتباسات الأدبية والفكرية على الهلال."
  canonicalUrl="https://quotes.elhellal.com/authors/"
>
  <BreadcrumbSchema items={breadcrumbs} />

  <main id="main-content" class="page">
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="https://elhellal.com/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href="/">الاقتباسات</a>
      <span aria-hidden="true">›</span>
      <span>الكتّاب</span>
    </nav>

    <header class="index-head">
      <p class="eyebrow">تصفّح حسب الكاتب</p>
      <h1 class="page-title">الكتّاب</h1>
      <p class="page-lede">{authors.length} كاتباً لهم اقتباسات على الهلال</p>
    </header>

    <ul role="list" class="people">
      {authors.map((a) => (
        <li>
          <a href={`/${encodeURIComponent(a.slug)}/`} class="person">
            {a.authorImage ? (
              <img src={a.authorImage} alt="" class="avatar" loading="lazy" width="88" height="88" />
            ) : (
              <span class="avatar avatar--initial" aria-hidden="true">{a.author.trim().charAt(0)}</span>
            )}
            <span class="person-name">{a.author}</span>
            <span class="person-meta">{a.quotes.length} اقتباس</span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <style>
    .index-head { margin-bottom: clamp(32px, 5vw, 48px); }
  </style>
</Layout>
