---
import Layout from "../../layouts/Layout.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import { getQuoteBooks } from "../../utils/quotes";

const books = getQuoteBooks();

const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: "الاقتباسات", url: "https://quotes.elhellal.com/" },
  { name: "الكتب" },
];
---

<Layout
  site="الهلال - اقتباسات حسب الكتاب"
  title="الهلال"
  tagline="أجمل الاقتباسات العربية من أشهر الكتّاب والكتب"
  pageTitle="تصفح الاقتباسات حسب الكتاب | الهلال"
  pageDescription="تصفح جميع الكتب التي استُخرجت منها الاقتباسات الأدبية والفكرية على الهلال."
  canonicalUrl="https://quotes.elhellal.com/books/"
>
  <BreadcrumbSchema items={breadcrumbs} />

  <main id="main-content" class="page">
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="https://elhellal.com/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href="/">الاقتباسات</a>
      <span aria-hidden="true">›</span>
      <span>الكتب</span>
    </nav>

    <header class="index-head">
      <p class="eyebrow">تصفّح حسب الكتاب</p>
      <h1 class="page-title">الكتب</h1>
      <p class="page-lede">{books.length} كتاباً استُخرجت منها اقتباسات</p>
    </header>

    <ul role="list" class="shelf">
      {books.map((b) => (
        <li>
          <a href={`/book/${encodeURIComponent(b.slug)}/`} class="shelf-item">
            {b.cover ? (
              <img src={b.cover} alt={b.book} class="cover" loading="lazy" />
            ) : (
              <span class="cover cover--initial" aria-hidden="true">{b.book.trim().charAt(0)}</span>
            )}
            <span class="shelf-title">{b.book}</span>
            <span class="shelf-meta">{b.author} · {b.quotes.length} اقتباساً</span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <style>
    .index-head { margin-bottom: clamp(32px, 5vw, 48px); }
  </style>
</Layout>
