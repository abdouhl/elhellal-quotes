---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { QuoteRow } from "../../components/QuoteCard";
import AdUnit from "../../components/AdUnit.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import QuoteSchema from "../../components/schema/QuoteSchema.astro";
import { loadQuoteShard, tagPageKey } from "../../utils/quote-shard";
import type { FlatQuote } from "../../types";

const tagSlug = Astro.params.tag as string;

// Precomputed at build time by scripts/generate-quote-indices.ts (only tags
// meeting MIN_QUOTES_PER_TAG are included), split into fixed-size pages — one
// small static-asset fetch per request instead of scanning all ~15k quotes,
// and never parsing or rendering more than one page of quotes (the biggest
// tags have 1,000+, which blew the Workers CPU budget).
const pageParam = Astro.url.searchParams.get("page");
const page = pageParam === null ? 1 : /^[1-9]\d{0,4}$/.test(pageParam) ? Number(pageParam) : NaN;
const basePath = `/tag/${encodeURIComponent(tagSlug)}/`;
if (pageParam === "1") {
  return Astro.redirect(basePath, 301);
}

type TagPage = {
  label: string;
  total: number;
  pages: number;
  topAuthors: { name: string; slug: string; image?: string; count: number }[];
  quotes: FlatQuote[];
};
const key = Number.isNaN(page) ? null : tagPageKey(tagSlug, page);
const shard = key ? await loadQuoteShard<TagPage>("by-tag", key, Astro) : null;
const entry = key ? shard?.[key] : undefined;

if (!entry) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

// Tag pages only change on redeploy; let the browser and Cloudflare edge cache
// them for a day so repeat hits don't cost Worker CPU. Set after the 404
// branch so misses aren't cached.
Astro.response.headers.set("Cache-Control", "public, max-age=86400, s-maxage=86400");

const { label, quotes, total, pages, topAuthors } = entry;
const pageHref = (n: number) => (n === 1 ? basePath : `${basePath}?page=${n}`);

const canonicalUrl = `https://quotes.elhellal.com${pageHref(page)}`;

const pageDescription = `${total} اقتباساً مترجماً إلى العربية عن "${label}"، من ${topAuthors.length} ${topAuthors.length === 1 ? 'كاتب' : 'كتّاب'} مختلفين.`;

const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: "الاقتباسات", url: "https://quotes.elhellal.com/" },
  { name: label },
];
---

<Layout
  site={`الهلال - اقتباسات عن ${label}`}
  title="الهلال"
  tagline="أجمل الاقتباسات العربية من أشهر الكتّاب والكتب"
  pageTitle={page > 1 ? `اقتباسات عن ${label} - صفحة ${page} | الهلال` : `اقتباسات عن ${label} | الهلال`}
  pageDescription={pageDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={`اقتباسات عن ${label} | الهلال`}
  ogDescription={`${total} اقتباساً عن ${label}`}
  ogUrl={canonicalUrl}
  ogType="website"
>
  <QuoteSchema quotes={quotes} url={canonicalUrl} />
  <BreadcrumbSchema items={breadcrumbs} />

  <main id="main-content" class="page">
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="https://elhellal.com/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href="/">الاقتباسات</a>
      <span aria-hidden="true">›</span>
      <a href="/tags/">المواضيع</a>
      <span aria-hidden="true">›</span>
      <span>{label}</span>
    </nav>

    <header class="tag-hero theme-night">
      <p class="eyebrow">اقتباسات عن</p>
      <h1 class="tag-title">{label}</h1>
      <p class="page-lede">{total} اقتباساً من {topAuthors.length} {topAuthors.length === 1 ? 'كاتب' : 'كتّاب'}</p>
      {topAuthors.length > 0 && (
        <ul class="chip-list" role="list" aria-label="أبرز الكُتّاب في هذا الموضوع">
          {topAuthors.map((a) => (
            <li>
              <a href={`/${encodeURIComponent(a.slug)}/`} class="chip chip--person">
                {a.image ? (
                  <img src={a.image} alt="" class="chip-avatar" loading="lazy" />
                ) : (
                  <span class="chip-avatar avatar--initial" aria-hidden="true">{a.name.trim().charAt(0)}</span>
                )}
                {a.name} <span class="chip-count">{a.count}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    <AdUnit slot="8525183818" format="fluid" layout="in-article" className="quote-page-ad" />

    <section aria-label={`اقتباسات عن ${label}`}>
      <ul role="list" class="quote-row-list">
        {quotes.map((quote) => (
          <QuoteRow client:visible quote={quote} />
        ))}
      </ul>
    </section>

    {pages > 1 && (
      <nav class="pager" aria-label="التنقل بين الصفحات">
        {page > 1 && <a href={pageHref(page - 1)} rel="prev" class="chip">→ السابق</a>}
        <span class="pager-status">صفحة {page} من {pages}</span>
        {page < pages && <a href={pageHref(page + 1)} rel="next" class="chip">التالي ←</a>}
      </nav>
    )}
  </main>

  <style>
    .tag-hero {
      padding: clamp(40px, 7vw, 80px) clamp(20px, 5vw, 48px);
      text-align: center;
      margin-bottom: clamp(28px, 4vw, 44px);
      border-radius: 28px;
      box-shadow: var(--shadow-md);
    }
    .tag-hero .eyebrow::after {
      content: "";
      width: 18px;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
    }
    .tag-title {
      margin: 0;
      font-family: var(--font-quote);
      font-size: clamp(2.6rem, 8vw, 4.5rem);
      line-height: 1.3;
    }
    .tag-hero .chip-list {
      justify-content: center;
      margin-top: 24px;
    }
    .chip--person { padding-inline-start: 6px; }
    .pager {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 16px;
      margin-top: clamp(28px, 4vw, 44px);
    }
    .pager-status { color: var(--ink-2); font-size: 0.95rem; }
    .chip--person .chip-avatar { margin: 0; font-size: 11px; display: inline-flex; }
  </style>
</Layout>
