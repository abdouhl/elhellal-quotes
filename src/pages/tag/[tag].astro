---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { QuoteRow } from "../../components/QuoteCard";
import AdUnit from "../../components/AdUnit.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import QuoteSchema from "../../components/schema/QuoteSchema.astro";
import { loadQuoteShard } from "../../utils/quote-shard";
import type { FlatQuote } from "../../types";

const tagSlug = Astro.params.tag as string;

// Precomputed at build time by scripts/generate-quote-indices.ts (only tags
// meeting MIN_QUOTES_PER_TAG are included) — one small static-asset fetch (one of
// a fixed number of shards) instead of scanning + regex-extracting topics
// from all ~15k quotes per request.
const shard = await loadQuoteShard<{ label: string; quotes: FlatQuote[] }>("by-tag", tagSlug, Astro);
const entry = shard?.[tagSlug];

if (!entry) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const { label, quotes } = entry;

const canonicalUrl = `https://quotes.elhellal.com/tag/${encodeURIComponent(tagSlug)}/`;

// Top authors contributing to this topic — surfaces range and doubles as internal links.
const authorCounts = new Map<string, { name: string; slug: string; image?: string; count: number }>();
quotes.forEach((q) => {
  const cur = authorCounts.get(q.authorSlug) || { name: q.author, slug: q.authorSlug, image: q.authorImage, count: 0 };
  cur.count += 1;
  authorCounts.set(q.authorSlug, cur);
});
const topAuthors = [...authorCounts.values()].sort((a, b) => b.count - a.count).slice(0, 8);

const pageDescription = `${quotes.length} اقتباساً مترجماً إلى العربية عن "${label}"، من ${topAuthors.length} ${topAuthors.length === 1 ? 'كاتب' : 'كتّاب'} مختلفين.`;

const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: "الاقتباسات", url: "https://quotes.elhellal.com/" },
  { name: label },
];
---

<Layout
  site={`الهلال - اقتباسات عن ${label}`}
  title="الهلال"
  tagline="أجمل الاقتباسات العربية من أشهر الكتّاب والكتب"
  pageTitle={`اقتباسات عن ${label} | الهلال`}
  pageDescription={pageDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={`اقتباسات عن ${label} | الهلال`}
  ogDescription={`${quotes.length} اقتباساً عن ${label}`}
  ogUrl={canonicalUrl}
  ogType="website"
>
  <QuoteSchema quotes={quotes} url={canonicalUrl} />
  <BreadcrumbSchema items={breadcrumbs} />

  <main id="main-content" class="page">
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="https://elhellal.com/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href="/">الاقتباسات</a>
      <span aria-hidden="true">›</span>
      <a href="/tags/">المواضيع</a>
      <span aria-hidden="true">›</span>
      <span>{label}</span>
    </nav>

    <header class="tag-hero theme-night">
      <p class="eyebrow">اقتباسات عن</p>
      <h1 class="tag-title">{label}</h1>
      <p class="page-lede">{quotes.length} اقتباساً من {topAuthors.length} {topAuthors.length === 1 ? 'كاتب' : 'كتّاب'}</p>
      {topAuthors.length > 0 && (
        <ul class="chip-list" role="list" aria-label="أبرز الكُتّاب في هذا الموضوع">
          {topAuthors.map((a) => (
            <li>
              <a href={`/${encodeURIComponent(a.slug)}/`} class="chip chip--person">
                {a.image ? (
                  <img src={a.image} alt="" class="chip-avatar" loading="lazy" />
                ) : (
                  <span class="chip-avatar avatar--initial" aria-hidden="true">{a.name.trim().charAt(0)}</span>
                )}
                {a.name} <span class="chip-count">{a.count}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    <AdUnit slot="8525183818" format="fluid" layout="in-article" className="quote-page-ad" />

    <section aria-label={`اقتباسات عن ${label}`}>
      <ul role="list" class="quote-row-list">
        {quotes.map((quote) => (
          <QuoteRow client:visible quote={quote} />
        ))}
      </ul>
    </section>
  </main>

  <style>
    .tag-hero {
      padding: clamp(40px, 7vw, 80px) clamp(20px, 5vw, 48px);
      text-align: center;
      margin-bottom: clamp(28px, 4vw, 44px);
      border-radius: 28px;
      box-shadow: var(--shadow-md);
    }
    .tag-hero .eyebrow::after {
      content: "";
      width: 18px;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
    }
    .tag-title {
      margin: 0;
      font-family: var(--font-quote);
      font-size: clamp(2.6rem, 8vw, 4.5rem);
      line-height: 1.3;
    }
    .tag-hero .chip-list {
      justify-content: center;
      margin-top: 24px;
    }
    .chip--person { padding-inline-start: 6px; }
    .chip--person .chip-avatar { margin: 0; font-size: 11px; display: inline-flex; }
  </style>
</Layout>
