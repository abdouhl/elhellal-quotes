---
import Layout from "../layouts/Layout.astro";
import { QuoteRow } from "../components/QuoteCard";
import AdUnit from "../components/AdUnit.astro";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";
import QuoteSchema from "../components/schema/QuoteSchema.astro";
import PersonSchema from "../components/schema/PersonSchema.astro";
import { getQuoteAuthors, getQuoteBooks, getQuoteTags } from "../utils/quotes";
import { normalizeTag, slugifyTag } from "../utils/tag-slug";
import biographies from "../data/biographies.json";

export async function getStaticPaths() {
  return getQuoteAuthors().map((entry) => ({
    params: { author: entry.slug },
    props: { author: entry.author, authorImage: entry.authorImage, quotes: entry.quotes },
  }));
}

const { author, authorImage, quotes } = Astro.props;
const authorSlug = Astro.params.author as string;

const authorBooks = getQuoteBooks().filter((b) => b.authorSlug === authorSlug);

const qualifyingTagSlugs = new Set(getQuoteTags().map((t) => t.slug));
const tagCounts = new Map<string, { label: string; count: number }>();
quotes.forEach((q) => {
  // Guard against malformed source data (e.g. a tag stored as a nested
  // array instead of a string) so one bad quote can't crash the whole page.
  (q.tags || []).filter((t): t is string => typeof t === "string").forEach((raw) => {
    const label = normalizeTag(raw);
    const slug = slugifyTag(raw);
    if (!label || !slug || !qualifyingTagSlugs.has(slug)) return;
    const cur = tagCounts.get(slug) || { label, count: 0 };
    cur.count += 1;
    tagCounts.set(slug, cur);
  });
});
const topTags = [...tagCounts.entries()]
  .map(([slug, v]) => ({ slug, ...v }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 12);

const bookQuoteCount = quotes.filter((q) => q.book).length;
const directQuoteCount = quotes.length - bookQuoteCount;

// Set only when this author has a biography on biographies.elhellal.com (see `bun run sync-biographies`).
const biographyUrl = (biographies as string[]).includes(authorSlug)
  ? `https://biographies.elhellal.com/${encodeURIComponent(authorSlug)}/`
  : null;

const canonicalUrl = `https://quotes.elhellal.com/${encodeURIComponent(authorSlug)}/`;
const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: "الاقتباسات", url: "https://quotes.elhellal.com/" },
  { name: author },
];

const pageDescription = authorBooks.length > 0
  ? `${quotes.length} اقتباساً لـ${author} مترجماً إلى العربية، من ${authorBooks.length} ${authorBooks.length === 1 ? 'كتاب' : 'كتب'} ومن أقواله المباشرة.`
  : `${quotes.length} اقتباساً لـ${author} مترجماً إلى العربية.`;
---

<Layout
  site={`الهلال - اقتباسات ${author}`}
  title="الهلال"
  tagline="أجمل الاقتباسات العربية من أشهر الكتّاب والكتب"
  pageTitle={`اقتباسات ${author} | الهلال`}
  pageDescription={pageDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={`اقتباسات ${author} | الهلال`}
  ogDescription={`${quotes.length} اقتباساً لـ${author}`}
  ogUrl={canonicalUrl}
  ogImage={authorImage}
  ogType="profile"
>
  <PersonSchema name={author} url={canonicalUrl} image={authorImage} description={pageDescription} />
  <QuoteSchema quotes={quotes} url={canonicalUrl} />
  <BreadcrumbSchema items={breadcrumbs} />

  <main id="main-content" class="page">
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="https://elhellal.com/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href="/">الاقتباسات</a>
      <span aria-hidden="true">›</span>
      <a href="/authors/">الكتّاب</a>
      <span aria-hidden="true">›</span>
      <span>{author}</span>
    </nav>

    <header class="profile theme-night">
      {authorImage ? (
        <img src={authorImage} alt={author} class="avatar profile-avatar" loading="eager" width="148" height="148" />
      ) : (
        <span class="avatar avatar--initial profile-avatar" aria-hidden="true">{author.trim().charAt(0)}</span>
      )}
      <div class="profile-body">
        <p class="eyebrow">اقتباسات</p>
        <h1 class="page-title">{author}</h1>
        <ul class="profile-stats" role="list">
          <li><strong>{quotes.length}</strong> اقتباساً</li>
          {authorBooks.length > 0 && (
            <li><strong>{authorBooks.length}</strong> {authorBooks.length === 1 ? 'كتاب' : 'كتب'}</li>
          )}
          {directQuoteCount > 0 && bookQuoteCount > 0 && (
            <li><strong>{directQuoteCount}</strong> من أقواله المباشرة</li>
          )}
        </ul>
        {topTags.length > 0 && (
          <ul class="chip-list" role="list" aria-label="المواضيع الأكثر تكراراً">
            {topTags.map((t) => (
              <li>
                <a href={`/tag/${encodeURIComponent(t.slug)}/`} class="chip">
                  {t.label} <span class="chip-count">{t.count}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
        {biographyUrl && (
          <div class="profile-actions">
            <a href={biographyUrl} class="btn btn--primary">اقرأ السيرة <span aria-hidden="true">←</span></a>
          </div>
        )}
      </div>
    </header>

    {authorBooks.length > 0 && (
      <section class="section" aria-label="كتب هذا الكاتب">
        <div class="section-head">
          <h2>كتب {author}</h2>
        </div>
        <ul role="list" class="shelf">
          {authorBooks.map((b) => (
            <li>
              <a href={`/book/${encodeURIComponent(b.slug)}/`} class="shelf-item">
                {b.cover ? (
                  <img src={b.cover} alt={b.book} class="cover" loading="lazy" />
                ) : (
                  <span class="cover cover--initial" aria-hidden="true">{b.book.trim().charAt(0)}</span>
                )}
                <span class="shelf-title">{b.book}</span>
                <span class="shelf-meta">{b.quotes.length} اقتباساً</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <AdUnit slot="8525183818" format="fluid" layout="in-article" className="quote-page-ad" />

    <section class="section" aria-label={`كل اقتباسات ${author}`}>
      <div class="section-head">
        <h2>كل الاقتباسات</h2>
        <span class="see-all">{quotes.length}</span>
      </div>
      <ul role="list" class="quote-row-list">
        {quotes.map((quote) => (
          <QuoteRow client:visible quote={quote} showAuthor={false} />
        ))}
      </ul>
    </section>
  </main>

  <style>
    .profile-avatar {
      width: 148px;
      height: 148px;
      font-size: 3.5rem;
      box-shadow: 0 0 0 5px var(--night-2), 0 0 0 7px var(--gold), 0 20px 50px -10px rgba(230, 183, 92, 0.45);
    }
    @media (max-width: 640px) {
      .profile-avatar { width: 112px; height: 112px; }
    }
  </style>
</Layout>
