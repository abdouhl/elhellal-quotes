---
export const prerender = false;

import Layout from "../layouts/Layout.astro";

const browseLinks = [
    { title: "الكتّاب", href: "/authors/" },
    { title: "الكتب", href: "/books/" },
    { title: "المواضيع", href: "/tags/" },
];
---

<Layout
    site="اقتباسات الهلال"
    title="الصفحة غير موجودة"
    tagline="لا يمكننا العثور على الصفحة التي تبحث عنها"
    pageTitle="404 — الصفحة غير موجودة"
    pageDescription="الصفحة التي تبحث عنها غير موجودة أو تم نقلها. تصفّح أجمل الاقتباسات العربية على الهلال."
    ogTitle="404 — الصفحة غير موجودة | اقتباسات الهلال"
    ogType="website"
    ogSiteName="اقتباسات الهلال"
    noindex
>
    <main id="main-content" class="page not-found">
        <p class="not-found-code" aria-hidden="true">٤٠٤</p>
        <h1 class="page-title">هذه الصفحة غير موجودة</h1>
        <p class="page-lede">
            ربما تم نقل الرابط أو حذفه، أو أنك كتبت العنوان بشكل غير صحيح.
            تصفّح الاقتباسات حسب الكاتب أو الكتاب أو الموضوع.
        </p>
        <div class="not-found-actions">
            <a href="/" class="btn btn--primary">العودة للرئيسية</a>
            {browseLinks.map((link) => (
                <a href={link.href} class="btn">{link.title}</a>
            ))}
        </div>
    </main>
</Layout>

<style>
    .not-found {
        max-width: 40rem;
        padding-block: clamp(48px, 10vw, 120px);
        text-align: center;
    }
    .not-found-code {
        margin: 0 0 8px;
        font-family: var(--font-quote);
        font-size: clamp(4rem, 14vw, 7rem);
        font-weight: 700;
        line-height: 1.1;
        color: var(--accent);
    }
    .not-found-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin-top: 32px;
    }
</style>
