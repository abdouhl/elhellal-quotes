---
import { ViewTransitions } from "astro:transitions";
import WebSiteSchema from "../components/schema/WebSiteSchema.astro";
import "@new-ui/foundations";
import "../styles/global.css";

const DEFAULT_OG_IMAGE = "https://elhellal.com/og-image.jpg";

export interface Props {
    site: string;
    title: string;
    tagline: string;
    pageTitle?: string;
    pageDescription?: string;
    canonicalUrl?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    ogUrl?: string;
    ogType?: string;
    ogSiteName?: string;
    twitterCard?: string;
    twitterTitle?: string;
    twitterDescription?: string;
    twitterImage?: string;
    keywords?: string;
    noindex?: boolean;
    twitterCreator?: string;
}

const {
    site,
    title,
    tagline,
    pageTitle,
    pageDescription,
    canonicalUrl,
    ogTitle,
    ogDescription,
    ogImage = DEFAULT_OG_IMAGE,
    ogUrl,
    ogType,
    ogSiteName,
    twitterCard = "summary_large_image",
    twitterTitle,
    twitterDescription,
    twitterImage = ogImage,
    keywords,
    noindex = false,
    twitterCreator = "@abdou_hll",
} = Astro.props;

const path = Astro.url.pathname;
const navLinks = [
    { href: "/authors/", label: "الكتّاب", active: path.startsWith("/authors") },
    { href: "/books/", label: "الكتب", active: path.startsWith("/book") },
    { href: "/tags/", label: "المواضيع", active: path.startsWith("/tag") },
];
---

<!doctype html>
<html lang="ar" dir="rtl">
    
    <head>
        <!-- Google Funding Choices (ad-blocking recovery / Offerwall consent) — must load as early as possible in <head>, unprocessed and unbundled -->
        <script async is:inline src="https://fundingchoicesmessages.google.com/i/pub-3610150616518651?ers=1"></script>
        <script is:inline>
            (function () {
                function signalGooglefcPresent() {
                    if (!window.frames["googlefcPresent"]) {
                        if (document.body) {
                            const iframe = document.createElement("iframe");
                            iframe.style.width = "0";
                            iframe.style.height = "0";
                            iframe.style.border = "none";
                            iframe.style.zIndex = "-1000";
                            iframe.style.left = "-1000px";
                            iframe.style.top = "-1000px";
                            iframe.style.display = "none";
                            iframe.name = "googlefcPresent";
                            document.body.appendChild(iframe);
                        } else {
                            setTimeout(signalGooglefcPresent, 0);
                        }
                    }
                }
                signalGooglefcPresent();
            })();
        </script>

        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/xarticles.svg" />
        <link rel="apple-touch-icon" href="/icon-192.png" />
        <link rel="manifest" href="/manifest.json" />
        <meta name="theme-color" content="#0b1324" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#050a15" media="(prefers-color-scheme: dark)" />
        <link rel="preload" href="/woffs/ROM-Regular.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/woffs/ROM-Bold.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
        <meta name="generator" content={Astro.generator} />
        <title>
            {
                pageTitle
                    ? `${pageTitle} | الهلال`
                    : `${site} — أجمل الاقتباسات العربية من أشهر الكتّاب والكتب`
            }
        </title>
        <meta name="author" content="@abdou_hll" />
        {noindex && <meta name="robots" content="noindex, follow" />}
        <meta
            name="description"
            content={pageDescription ||
                "أجمل الاقتباسات العربية من أشهر الكتّاب والكتب"}
        />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link rel="canonical" href={canonicalUrl || `https://quotes.elhellal.com${Astro.url.pathname}`} />
        {ogTitle && <meta property="og:title" content={ogTitle} />}
        {ogType && <meta property="og:type" content={ogType} />}
        {
            ogDescription && (
                <meta property="og:description" content={ogDescription} />
            )
        }
        {ogImage && <meta property="og:image" content={ogImage} />}
        {ogImage === DEFAULT_OG_IMAGE && (
            <>
                <meta property="og:image:width" content="1200" />
                <meta property="og:image:height" content="630" />
            </>
        )}
        {ogUrl && <meta property="og:url" content={ogUrl} />}
        {ogSiteName && <meta property="og:site_name" content={ogSiteName} />}
        <meta property="og:locale" content="ar_AR" />
        {twitterCard && <meta name="twitter:card" content={twitterCard} />}
        <meta name="twitter:site" content="@abdou_hll" />
        <meta name="twitter:creator" content={twitterCreator} />
        {twitterTitle && <meta name="twitter:title" content={twitterTitle} />}
        {
            twitterDescription && (
                <meta name="twitter:description" content={twitterDescription} />
            )
        }
        {twitterImage && <meta name="twitter:image" content={twitterImage} />}
        {keywords && <meta name="keywords" content={keywords} />}

        <!-- Google tag (gtag.js) -->
        <script
            type="text/partytown"
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-MLVB12BM2C"
        ></script>
        <script type="text/partytown">
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                window.dataLayer.push(arguments);
            }
            gtag("js", new Date());

            gtag("config", "G-MLVB12BM2C");
        </script>

        <!-- Google AdSense (runs on the main thread — ad rendering needs direct DOM access, so it can't go through Partytown) -->
        <script
            async
            src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3610150616518651"
            crossorigin="anonymous"
        ></script>

        <ViewTransitions />
        <WebSiteSchema url="https://quotes.elhellal.com" />
    </head>

    <body>
        <a href="#main-content" class="skip-link">التخطي إلى المحتوى الرئيسي</a>

        <header class="site-header theme-night">
            <div class="site-header-inner">
                <a href="/" class="brand-link" aria-label="الهلال — الصفحة الرئيسية للاقتباسات">
                    <img src="/xarticles.svg" width="30" height="30" alt="" aria-hidden="true" />
                    <span class="brand-name">الهلال <span>اقتباسات</span></span>
                </a>
                <nav class="site-nav" aria-label="التنقل الرئيسي">
                    {navLinks.map((l) => (
                        <a href={l.href} aria-current={l.active ? "page" : undefined}>{l.label}</a>
                    ))}
                </nav>
                <div class="social-links">
                            <a
                                href="https://www.pinterest.com/elhellalcom/"
                                class="social-link"
                                aria-label="بينترست"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                                    <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.03-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.222-.174.269-.402.163-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
                                </svg>
                            </a>
                            <a
                                href="https://www.tiktok.com/@elhellal"
                                class="social-link"
                                aria-label="تيك توك"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                                    <path d="M16.6 5.82c-1.007-.98-1.671-2.152-1.913-3.53H12.35v13.75c0 1.94-1.578 3.517-3.517 3.517a3.52 3.52 0 0 1-3.518-3.517 3.52 3.52 0 0 1 3.518-3.517c.35 0 .687.052 1.006.148V9.315a6.156 6.156 0 0 0-1.006-.083C5.128 9.232 2 12.36 2 16.164 2 19.967 5.128 23.1 8.833 23.1c3.704 0 6.833-3.132 6.833-6.936V9.398a9.128 9.128 0 0 0 5.334 1.712V8.363a5.98 5.98 0 0 1-4.4-2.543z"/>
                                </svg>
                            </a>
                </div>
            </div>
        </header>

        <slot />

        <footer class="footer theme-night">
            <div class="footer-inner">
                <div class="footer-brand">
                    <a href="/" class="brand-link">
                        <img src="/xarticles.svg" width="30" height="30" alt="" aria-hidden="true" />
                        <span class="brand-name">الهلال <span>اقتباسات</span></span>
                    </a>
                    <p>{tagline}</p>
                </div>
                <nav class="footer-col" aria-label="تصفح">
                    <h2>تصفّح</h2>
                    <ul>
                        <li><a href="/authors/">الكتّاب</a></li>
                        <li><a href="/books/">الكتب</a></li>
                        <li><a href="/tags/">المواضيع</a></li>
                    </ul>
                </nav>
                <nav class="footer-col" aria-label="شبكة الهلال">
                    <h2>الهلال</h2>
                    <ul>
                        <li><a href="https://elhellal.com/">المقالات</a></li>
                        <li><a href="https://books.elhellal.com/">ملخصات الكتب</a></li>
                        <li><a href="https://elhellal.com/privacy/">الخصوصية</a></li>
                        <li><a href="https://elhellal.com/terms/">الشروط</a></li>
                    </ul>
                </nav>
                <p class="footer-copy">
                    <span>ABDERAHMANE HELLAL 2026 © <a href="https://elhellal.com/" target="_blank" rel="noopener noreferrer">@abdou_hll</a></span>
                    <a href="/sitemap-index.xml">خريطة الموقع</a>
                </p>
            </div>
        </footer>
    </body>
</html>

<script is:inline>
    (function () {
        // Navigation & UI Management
        let previousScrollPosition = 0;

        const handleNavScroll = () => {
            const currentScrolledPosition =
                window.scrollY || window.pageYOffset;
            previousScrollPosition = currentScrolledPosition;
        };

        function throttle(callback, delay) {
            let waiting = false;
            return function () {
                if (waiting) return;
                waiting = true;
                callback();
                setTimeout(() => {
                    waiting = false;
                }, delay);
            };
        }


        // Create throttled scroll handler once
        const throttledNavScroll = throttle(handleNavScroll, 80);

        // Lazy-fills <ins class="adsbygoogle"> slots: each one is only requested
        // once it is within ~300px of the viewport, so below-the-fold ads don't
        // compete with first paint and the ads that do load are actually seen
        // (viewability drives what advertisers bid).
        //
        // adsbygoogle.push({}) fills the *first unprocessed* <ins> in document
        // order, not a specific one — so when a slot becomes visible we push once
        // for every unrequested slot up to and including it.
        const requestAdsUpTo = (target) => {
            const slots = Array.from(
                document.querySelectorAll("ins.adsbygoogle"),
            );
            const last = slots.indexOf(target);
            for (let i = 0; i <= last; i++) {
                const ins = slots[i];
                if (
                    ins.getAttribute("data-adsbygoogle-status") ||
                    ins.dataset.adRequested
                ) {
                    continue;
                }
                ins.dataset.adRequested = "1";
                (window.adsbygoogle = window.adsbygoogle || []).push({});
            }
        };

        let adObserver = null;
        const loadAds = () => {
            try {
                const waiting = document.querySelectorAll(
                    "ins.adsbygoogle:not([data-ad-requested]):not([data-adsbygoogle-status])",
                );
                if (!("IntersectionObserver" in window)) {
                    waiting.forEach(requestAdsUpTo);
                    return;
                }
                adObserver =
                    adObserver ||
                    new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (!entry.isIntersecting) return;
                                adObserver.unobserve(entry.target);
                                requestAdsUpTo(entry.target);
                            });
                        },
                        { rootMargin: "300px 0px" },
                    );
                waiting.forEach((ins) => adObserver.observe(ins));
            } catch (e) {}
        };
        window.__elhellalLoadAds = loadAds;

        // Core Initialization (Runs on every page load including initial)
        const init = () => {
            loadAds();
        };

        // Scroll Restoration
        history.scrollRestoration = "manual";
        window.onbeforeunload = () => window.scrollTo(0, 0);

        // Global Event Listeners (ensure single attachment)
        if (!window.__rom_initialized) {
            window.addEventListener("scroll", throttledNavScroll);
            document.addEventListener("astro:page-load", init);
            window.__rom_initialized = true;
        }

        // Initial run for the current page
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init);
        } else {
            init();
        }
    })();
</script>